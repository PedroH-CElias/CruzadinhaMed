# =====================================================================
# Variáveis de ambiente do app (Expo). Copie este arquivo para ".env" e ajuste.
#
# Atenção: variáveis EXPO_PUBLIC_* ficam DENTRO do app e qualquer pessoa pode lê-las.
# Nunca coloque senhas ou chaves secretas aqui.
# =====================================================================

# URL da API em produção (obrigatoriamente HTTPS nas versões de loja).
# Deixe vazio/comentado no desenvolvimento: o app usa automaticamente o IP do seu PC (Expo Go).
# EXPO_PUBLIC_API_URL=https://api.seudominio.com.br
